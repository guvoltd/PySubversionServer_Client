/* SVN Desktop Suite — Blue Theme */

QMainWindow, QDialog {
    background: qlineargradient(x1:0, y1:0, x2:0.6, y2:1,
        stop:0 #0b3d63, stop:0.55 #124a78, stop:1 #1a5c94);
    color: #eaf2fb;
}

QWidget {
    color: #eaf2fb;
    selection-background-color: #2f9bf0;
    selection-color: #ffffff;
}

QMenuBar {
    background-color: #08243d;
    color: #eaf2fb;
    border-bottom: 1px solid #0f3a5f;
}

QMenuBar::item:selected {
    background-color: #1a5c94;
    border-radius: 4px;
}

QMenu {
    background-color: #0d2e4d;
    color: #eaf2fb;
    border: 1px solid #1a5c94;
}

QMenu::item:selected {
    background-color: #2f9bf0;
}

QToolBar {
    background-color: #08243d;
    border-bottom: 1px solid #0f3a5f;
    spacing: 4px;
    padding: 3px;
}

QStatusBar {
    background-color: #08243d;
    border-top: 1px solid #0f3a5f;
    color: #cfe3f7;
}

QTreeView, QTableView, QListWidget {
    background-color: rgba(8, 36, 61, 0.55);
    alternate-background-color: rgba(20, 60, 95, 0.4);
    color: #eaf2fb;
    border: 1px solid #1a5c94;
    border-radius: 6px;
    selection-background-color: #2f9bf0;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #0d2e4d;
    color: #cfe3f7;
    border: 1px solid #1a5c94;
    padding: 4px;
}

QPlainTextEdit, QTextEdit {
    background-color: rgba(8, 36, 61, 0.55);
    color: #eaf2fb;
    border: 1px solid #1a5c94;
    border-radius: 6px;
    font-family: "Monospace", "Courier New", monospace;
    font-size: 10pt;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2f77b0, stop:1 #1c5185);
    color: #ffffff;
    border: 1px solid #3a8fd6;
    border-radius: 6px;
    padding: 5px 15px;
    min-height: 20px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3a8fd6, stop:1 #256394);
}

QPushButton:pressed {
    background-color: #164066;
}

QPushButton:default {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2f9bf0, stop:1 #1f78c4);
    color: #ffffff;
    border-color: #4fb1ff;
}

QLineEdit, QComboBox, QSpinBox {
    background-color: rgba(8, 36, 61, 0.6);
    color: #eaf2fb;
    border: 1px solid #2f77b0;
    border-radius: 6px;
    padding: 4px 8px;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #0d2e4d;
    color: #eaf2fb;
    selection-background-color: #2f9bf0;
    border: 1px solid #1a5c94;
}

QGroupBox {
    border: 1px solid #1a5c94;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: rgba(8, 36, 61, 0.35);
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #cfe3f7;
}

QTabWidget::pane {
    border: 1px solid #1a5c94;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #0d2e4d;
    color: #cfe3f7;
    border: 1px solid #1a5c94;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 16px;
}

QTabBar::tab:selected {
    background-color: #1a5c94;
    color: #ffffff;
}

QSplitter::handle {
    background-color: #1a5c94;
}

QCheckBox::indicator, QRadioButton::indicator {
    border: 1px solid #3a8fd6;
    background-color: rgba(8, 36, 61, 0.6);
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #2f9bf0;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
}

QScrollBar::handle {
    background: #2f77b0;
    border-radius: 4px;
}

QScrollBar::handle:hover {
    background: #3a8fd6;
}
